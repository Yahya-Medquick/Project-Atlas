# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Base URL for custom domains, canonical URLs, and SEO sitemaps
# Override this when deploying to custom domain (e.g. PUBLIC_BASE_URL="https://bifrost-ai.com")
PUBLIC_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External API Keys for extended rate limits & news
# Note: Project Atlas features built-in fallback APIs (Wikipedia, OpenAlex, Google Books, Public GitHub REST API, Reddit API, Gemini AI Synthesis) when these keys are omitted.
NEWS_API_KEY=""
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="863164045495-rjdd6sp0f71vnu6sug34vtoqretbvnlb.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="863164045495-rjdd6sp0f71vnu6sug34vtoqretbvnlb.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Secret key for session signing / JWT verification
SESSION_SECRET="bifrost_ai_engine_secret_session_key_2026"

# Google Books API Key
GOOGLE_BOOKS_API_KEY=""

# Administrative API secret token for protected mutation endpoints
ADMIN_TOKEN=""

# PostgreSQL / Supabase connection credentials
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""
